# ═══════════════════════════════════════════════════════════════
# GEOTHORITY — Environment Variables
# Copy this to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── CRITICAL (App won't work properly without these) ─────────

# Supabase (required for auth, database, storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI (required for AI Overview, content gen, schema, chat)
OPENAI_API_KEY=sk-...

# Google Maps (required for real competitor data, GBP, location)
GOOGLE_MAPS_API_KEY=AIza...

# Foursquare (required for listing sync across 50+ directories)
# Preferred current auth:
FOURSQUARE_API_KEY=fsq...
# Legacy fallback (only needed if you're still using older V2 credentials):
# FOURSQUARE_CLIENT_ID=...
# FOURSQUARE_CLIENT_SECRET=...

# ─── RECOMMENDED (Features work but degraded without these) ───

# Stripe (required for paid subscriptions)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_GROWTH_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_AUTHORITY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_AGENCY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_GROWTH_ANNUAL_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_AUTHORITY_ANNUAL_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_AGENCY_ANNUAL_PRICE_ID=price_...

# Resend (required for email alerts, onboarding journey)
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=Geothority <alerts@geothority.io>

# Google OAuth runtime credentials (needed for server-side GBP token refresh / publishing)
# Initial Google sign-in provider setup still happens in Supabase.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Perplexity (for real Perplexity AI Overview results)
PERPLEXITY_API_KEY=pplx-...

# Anthropic (for real Claude AI Overview results)
ANTHROPIC_API_KEY=sk-ant-...

# ─── OPTIONAL (Nice-to-have integrations) ────────────────────

# SerpAPI (for real Google SERP data)
SERP_API_KEY=xxx...

# Aggregator integrations
SEMRUSH_API_KEY=xxx...
YEXT_API_KEY=xxx...
YEXT_ACCOUNT_ID=xxx...
VENDASTA_API_KEY=xxx...

# ─── APP CONFIG ───────────────────────────────────────────────

# Public base URL used in client-visible links and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Server-side canonical URL. Keep this aligned with NEXT_PUBLIC_APP_URL.
# In Railway production, you can point both at your custom domain.
APP_URL=http://localhost:3010

# Reputation transport: auto | simulated | twilio
GEOTHORITY_REPUTATION_TRANSPORT=auto
UPSTASH_QSTASH_URL=
UPSTASH_QSTASH_TOKEN=
GEOTHORITY_REPUTATION_JOB_SECRET=replace-with-a-long-random-job-secret
# Used for generic event ingestion, separate from Twilio webhooks.
GEOTHORITY_REPUTATION_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

CRON_SECRET=replace-with-a-long-random-cron-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
